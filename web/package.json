{
  "name": "goldmeta-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_ENABLE_UI_REVIEW=true vite",
    "build": "tsc -b && vite build",
    "build:ui-review": "tsc -b && VITE_ENABLE_UI_REVIEW=true vite build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "NODE_ENV=test VITE_ENABLE_UI_REVIEW=true vitest run",
    "test:watch": "NODE_ENV=test VITE_ENABLE_UI_REVIEW=true vitest",
    "test:e2e": "playwright test",
    "test:production-bundle": "node scripts/assert-production-bundle-clean.mjs",
    "gate:production-config": "node scripts/assert-production-firebase-config.mjs",
    "gate:production-config:env": "node scripts/assert-production-firebase-config.mjs --env",
    "gate:production-config:dist": "node scripts/assert-production-firebase-config.mjs --dist",
    "deploy:cloudflare:production": "node scripts/deploy-cloudflare-production.mjs",
    "preview": "vite preview",
    "preview:ui-review": "npm run build:ui-review && vite preview",
    "verify:brand": "node scripts/verify-brand-assets.mjs",
    "postdeploy:check": "node scripts/post-deploy-check.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
