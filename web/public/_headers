# Security / caching headers for Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# HTML entry must revalidate so clients pick up new hashed asset references quickly.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Service worker must never stick on the custom-domain edge (max-age here
# previously left phones on an old shell that still said "Blocked").
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Hashed assets: long cache, but revalidate so a poisoned HTML fallback cannot stick forever.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/gm/*
  Cache-Control: public, max-age=86400, must-revalidate
