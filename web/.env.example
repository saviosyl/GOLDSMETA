# Copy to .env.local — never commit real secrets.
# Full checklist: docs/FIREBASE_FIRST_DEPLOY.md
#
# Phased rollout:
#   1) Fill VITE_FIREBASE_* and run/deploy the web app
#   2) Point VITE_API_BASE_URL at your Functions URL when backend is live
#   3) Web Push needs backend VAPID_* only (no VAPID vars in this file)

VITE_API_BASE_URL=http://127.0.0.1:8080

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
