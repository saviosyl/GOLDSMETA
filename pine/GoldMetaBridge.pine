//@version=6
indicator("GoldMeta Bridge", shorttitle="GoldMeta Bridge", overlay=true, max_labels_count=50, max_lines_count=50, max_bars_back=5000)

// GoldMeta Pine Script bridge — Phase 2 (gm_svp_v1 / gm_trend_v1 / gm_candle_v1)
//
// TradingView alert setup:
// 1. Add this script to an XAUUSD 15-minute chart.
// 2. Open Alerts → this indicator → "Any alert() function call".
// 3. Webhook URL: https://<region>-<project-id>.cloudfunctions.net/api/webhooks/tradingview/<webhookId>
// 4. Message: {{alert_message}}
// 5. Frequency: once per bar close (script uses alert.freq_once_per_bar_close when confirmed-bar mode is ON).
//
// Values labeled gm_* are GoldMeta-derived equivalents calculated inside this script.
// They are NOT claimed to be identical to proprietary Volume Profile / Trend Meter products.
// TPO market-profile fields remain unavailable (null) unless supplied by a separate licensed alert.
//
// Non-repainting rules: closed bars only for alerts; request.security(..., lookahead_off); no future data.
// Pine v6 note: user functions must not reassign global scalars; VP helpers return tuples and/or
// mutate array contents by reference. All scalar state is assigned at global scope.
// GoldMeta provides market analysis and decision support only. Trading involves substantial risk.

const string SCRIPT_VERSION = "2.0.3"
const string METHOD_VP = "gm_svp_v1"
const string METHOD_TREND = "gm_trend_v1"
const string METHOD_CANDLE = "gm_candle_v1"
const float VA_PCT = 70.0
const int MAX_BINS = 300

groupSymbol = "Symbol"
expectedSymbol = input.string("XAUUSD", "Expected symbol", group=groupSymbol)

groupTimeframes = "Timeframes"
htf1Input = input.timeframe("60", "Trend HTF 1", group=groupTimeframes)
htf2Input = input.timeframe("240", "Trend HTF 2", group=groupTimeframes)

groupAlerts = "Alerts"
enableAlertCalls = input.bool(true, "Call alert() from script", group=groupAlerts)
confirmedBarMode = input.bool(true, "Confirmed-bar mode", group=groupAlerts)
testAlertMode = input.bool(false, "Test-alert mode", group=groupAlerts)
payloadSecret = input.string("", "Optional payload secret", group=groupAlerts, tooltip="Leave blank unless your backend validates a payload-level shared secret.")

groupLevels = "Levels"
showDiagnosticLevels = input.bool(true, "Plot POC / VAH / VAL / session", group=groupLevels)
swingLength = input.int(5, "Swing pivot length (diagnostic)", minval=1, maxval=50, group=groupLevels)
atrLength = input.int(14, "ATR length", minval=1, maxval=200, group=groupLevels)
emaFastLen = input.int(21, "Trend EMA fast", minval=2, maxval=200, group=groupLevels)
emaSlowLen = input.int(50, "Trend EMA slow", minval=3, maxval=400, group=groupLevels)

groupStatus = "Status"
showStatusTable = input.bool(true, "Show status table", group=groupStatus)
showWarnings = input.bool(true, "Show symbol warning", group=groupStatus)
diagnosticMode = input.bool(false, "Diagnostic mode", group=groupStatus)

// --- Pure helpers (no global scalar mutation) ---
f_json_string(string value) =>
    string escaped = str.replace_all(value, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    "\"" + escaped + "\""

f_json_string_or_null(string value) =>
    str.length(value) == 0 ? "null" : f_json_string(value)

f_json_number(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

f_json_number_raw(float value) =>
    na(value) ? "null" : str.tostring(value)

f_json_bool(bool value) =>
    value ? "true" : "false"

f_json_time(int timestamp) =>
    f_json_string(str.format_time(timestamp, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC"))

f_session_name(int utcHour) =>
    utcHour >= 0 and utcHour < 7 ? "ASIA" :
      utcHour >= 7 and utcHour < 13 ? "LONDON" :
      utcHour >= 13 and utcHour < 17 ? "OVERLAP" :
      utcHour >= 17 and utcHour < 22 ? "NEWYORK" : "UNKNOWN"

f_candle_direction(float candleOpen, float candleClose) =>
    candleClose > candleOpen ? "BULLISH" : candleClose < candleOpen ? "BEARISH" : "NEUTRAL"

f_percent(float numerator, float denominator) =>
    denominator == 0.0 or na(denominator) ? na : numerator / denominator * 100.0

f_clamp100(float value) =>
    math.max(0.0, math.min(100.0, value))

f_trend_dir(float c, float eFast, float eSlow) =>
    not na(c) and not na(eFast) and not na(eSlow) ? c > eFast and eFast > eSlow ? "BULLISH" : c < eFast and eFast < eSlow ? "BEARISH" : "NEUTRAL" : "NEUTRAL"

f_trend_strength(float c, float eFast, float eSlow, float atrv, string dir) =>
    float sep = math.abs(nz(eFast) - nz(eSlow))
    float atrSafe = na(atrv) or atrv <= 0 ? syminfo.mintick * 10.0 : atrv
    float base = f_clamp100(sep / atrSafe * 40.0)
    float align = dir == "NEUTRAL" ? 0.0 : 35.0
    float stretch = na(c) or na(eFast) ? 0.0 : f_clamp100(math.abs(c - eFast) / atrSafe * 25.0)
    f_clamp100(base + align + stretch * 0.4)

f_signed(string dir, float strength) =>
    dir == "BULLISH" ? strength : dir == "BEARISH" ? -strength : 0.0

f_bin_size(float atrv) =>
    math.max(syminfo.mintick * 10.0, nz(atrv, syminfo.mintick * 10.0) / 20.0)

// Returns a fresh session histogram. Caller assigns returned scalars/array at global scope.
f_init_profile(float barLow, float atrv) =>
    float bSize = f_bin_size(atrv)
    float anchor = math.floor(barLow / bSize) * bSize
    float[] vols = array.new_float()
    array.push(vols, 0.0)
    [vols, anchor, bSize]

// Mutates vols in place; returns updated [anchor, overflow, ok].
// After success, idx is guaranteed to satisfy 0 <= idx < array.size(vols) for the
// index that was requested *before* any left expansion of other indices.
f_ensure_index(float[] vols, float anchor, float bSize, bool overflow, int idx) =>
    float a = anchor
    bool ov = overflow
    bool ok = true
    int sz = array.size(vols)
    if na(bSize) or bSize <= 0.0 or na(a)
        ov := true
        ok := false
    else if idx < 0
        int need = -idx
        if need <= 0 or sz + need > MAX_BINS
            ov := true
            ok := false
        else
            for i = 0 to need - 1
                array.unshift(vols, 0.0)
            a := a - need * bSize
    else if idx >= sz
        int need = idx - sz + 1
        if need <= 0 or sz + need > MAX_BINS
            ov := true
            ok := false
        else
            for i = 0 to need - 1
                array.push(vols, 0.0)
    [a, ov, ok]

// Floor price into a bin index relative to anchor/binSize.
f_bin_index(float price, float anchor, float bSize) =>
    int(math.floor((price - anchor) / bSize))

// True when [startIdx, endIdx] is fully inside vols (no silent clamp).
f_range_in_bounds(float[] vols, int startIdx, int endIdx) =>
    int sz = array.size(vols)
    sz > 0 and startIdx >= 0 and endIdx >= 0 and startIdx <= endIdx and endIdx < sz

// Mutates vols in place; returns [anchor, overflow, added].
// Critical: after any left-side expansion, BOTH startIdx and endIdx are recomputed
// before expanding the high side. Never write outside [0, size).
// If the range cannot be accommodated safely: overflow=true, added=false (no silent clamp).
f_add_bar_to_profile(float[] vols, float anchor, float bSize, bool overflow, float barLow, float barHigh, float barVol) =>
    float a = anchor
    bool ov = overflow
    bool added = false
    bool skip = ov or na(bSize) or bSize <= 0.0 or na(barVol) or barVol <= 0.0 or na(a) or array.size(vols) <= 0
    if skip
        ov := true
    else
        float loPrice = math.min(barLow, barHigh)
        float hiPrice = math.max(barLow, barHigh)
        int startIdx = f_bin_index(loPrice, a, bSize)
        int endIdx = f_bin_index(hiPrice, a, bSize)

        // 1) Expand for the low side (may unshift and move the anchor left).
        [a1, ov1, ok1] = f_ensure_index(vols, a, bSize, ov, startIdx)
        a := a1
        ov := ov1
        if not ok1 or ov
            ov := true
        else
            // 2) Recompute BOTH indices after a possible left expansion.
            startIdx := f_bin_index(loPrice, a, bSize)
            endIdx := f_bin_index(hiPrice, a, bSize)

            // 3) Expand for the high side using the recomputed endIdx.
            [a2, ov2, ok2] = f_ensure_index(vols, a, bSize, ov, endIdx)
            a := a2
            ov := ov2
            if not ok2 or ov
                ov := true
            else
                // 4) Final recompute after high-side expansion.
                startIdx := f_bin_index(loPrice, a, bSize)
                endIdx := f_bin_index(hiPrice, a, bSize)

                // 5) Hard bounds check — overflow instead of clamping/distorting VP.
                if not f_range_in_bounds(vols, startIdx, endIdx)
                    ov := true
                else
                    int bins = endIdx - startIdx + 1
                    float share = barVol / bins
                    bool writeOk = true
                    for i = startIdx to endIdx
                        // Runtime-safe guard on every get/set (no silent clamp).
                        if writeOk
                            if i < 0 or i >= array.size(vols)
                                writeOk := false
                            else
                                array.set(vols, i, array.get(vols, i) + share)
                    if writeOk
                        added := true
                    else
                        ov := true
    [a, ov, added]
// Pure computation from histogram state; returns [poc, vah, val, total].
f_compute_value_area(float[] vols, float anchor, float bSize, bool overflow) =>
    float poc = na
    float vah = na
    float val = na
    float total = na
    int size = array.size(vols)
    if size > 0 and not overflow and not na(anchor) and not na(bSize) and bSize > 0.0
        float sum = 0.0
        int pocIdx = 0
        float pocVol = array.get(vols, 0)
        for i = 0 to size - 1
            float v = array.get(vols, i)
            sum += v
            if v > pocVol
                pocVol := v
                pocIdx := i
        total := sum
        if sum > 0.0
            float target = sum * (VA_PCT / 100.0)
            int lo = pocIdx
            int hi = pocIdx
            float covered = pocVol
            while covered < target and (lo > 0 or hi < size - 1)
                float below = lo > 0 ? array.get(vols, lo - 1) : -1.0
                float above = hi < size - 1 ? array.get(vols, hi + 1) : -1.0
                if above >= below
                    hi += 1
                    covered += array.get(vols, hi)
                else
                    lo -= 1
                    covered += array.get(vols, lo)
            poc := anchor + (pocIdx + 0.5) * bSize
            val := anchor + lo * bSize
            vah := anchor + (hi + 1) * bSize
    [poc, vah, val, total]

symbolUpper = str.upper(syminfo.ticker)
expectedUpper = str.upper(expectedSymbol)
symbolOk = str.contains(symbolUpper, expectedUpper)
payloadSymbol = symbolOk ? expectedUpper : syminfo.ticker

confirmedNow = barstate.isconfirmed
canEmitBar = confirmedBarMode ? confirmedNow : true
eventType = testAlertMode ? "TEST" : confirmedNow ? "BAR_CLOSE" : "BAR_UPDATE"

utcHour = hour(time, "UTC")
sessionName = f_session_name(utcHour)
sessionChanged = bar_index == 0 ? true : sessionName != sessionName[1]
sessionKnown = sessionName != "UNKNOWN"

var float sessionHigh = na
var float sessionLow = na
var int sessionStartTs = na
if sessionChanged or na(sessionHigh) or na(sessionLow)
    sessionHigh := high
    sessionLow := low
    sessionStartTs := time
else
    sessionHigh := math.max(sessionHigh, high)
    sessionLow := math.min(sessionLow, low)

atrValue = ta.atr(atrLength)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// --- gm_svp_v1: session volume profile (GoldMeta-derived, not proprietary VP) ---
var float[] binVolumes = array.new_float()
var float profileAnchor = na
var float binSizeUsed = na
var bool profileOverflow = false
var float pocPrice = na
var float vahPrice = na
var float valPrice = na
var float profileTotalVolume = na

if sessionChanged
    if sessionKnown
        [initVols, initAnchor, initSize] = f_init_profile(low, atrValue)
        binVolumes := initVols
        profileAnchor := initAnchor
        binSizeUsed := initSize
        profileOverflow := false
        pocPrice := na
        vahPrice := na
        valPrice := na
        profileTotalVolume := na
    else
        array.clear(binVolumes)
        profileAnchor := na
        binSizeUsed := na
        profileOverflow := false
        pocPrice := na
        vahPrice := na
        valPrice := na
        profileTotalVolume := na

// Accumulate only on confirmed bars (historical bars are confirmed; live bar waits for close).
bool profileReady = false
if sessionKnown and confirmedNow and not na(binSizeUsed)
    [nextAnchor, nextOverflow, added] = f_add_bar_to_profile(binVolumes, profileAnchor, binSizeUsed, profileOverflow, low, high, volume)
    profileAnchor := nextAnchor
    profileOverflow := nextOverflow
    if added
        [nextPoc, nextVah, nextVal, nextTotal] = f_compute_value_area(binVolumes, profileAnchor, binSizeUsed, profileOverflow)
        pocPrice := nextPoc
        vahPrice := nextVah
        valPrice := nextVal
        profileTotalVolume := nextTotal
    profileReady := not profileOverflow and not na(pocPrice) and not na(vahPrice) and not na(valPrice)
else if sessionKnown and not na(pocPrice) and not profileOverflow
    profileReady := true

acceptanceState = not profileReady ? "UNKNOWN" : close >= valPrice and close <= vahPrice ? "ACCEPTANCE" : close > vahPrice or close < valPrice ? "REJECTION" : "UNKNOWN"

// --- gm_trend_v1 ---
chartDir = f_trend_dir(close, emaFast, emaSlow)
chartStrength = f_trend_strength(close, emaFast, emaSlow, atrValue, chartDir)

[htf1Close, htf1EmaFast, htf1EmaSlow, htf1Atr] = request.security(syminfo.tickerid, htf1Input, [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.atr(atrLength)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htf2Close, htf2EmaFast, htf2EmaSlow, htf2Atr] = request.security(syminfo.tickerid, htf2Input, [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.atr(atrLength)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

htf1Dir = f_trend_dir(htf1Close, htf1EmaFast, htf1EmaSlow)
htf1Strength = f_trend_strength(htf1Close, htf1EmaFast, htf1EmaSlow, htf1Atr, htf1Dir)
htf2Dir = f_trend_dir(htf2Close, htf2EmaFast, htf2EmaSlow)
htf2Strength = f_trend_strength(htf2Close, htf2EmaFast, htf2EmaSlow, htf2Atr, htf2Dir)

aggSigned = (f_signed(chartDir, chartStrength) + f_signed(htf1Dir, htf1Strength) + f_signed(htf2Dir, htf2Strength)) / 3.0
trendDirection = aggSigned >= 15.0 ? "BULLISH" : aggSigned <= -15.0 ? "BEARISH" : "NEUTRAL"
trendStrength = f_clamp100(math.abs(aggSigned))

// --- gm_candle_v1 ---
barRange = high - low
body = math.abs(close - open)
bodyPercent = f_percent(body, barRange)
upperWickPercent = f_percent(high - math.max(open, close), barRange)
lowerWickPercent = f_percent(math.min(open, close) - low, barRange)
candleDirection = f_candle_direction(open, close)

bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
candleType = bullEngulf or bearEngulf ? "ENGULFING" : ""

prevClose = close[1]
brokeAboveVah = profileReady and not na(vahPrice) and prevClose <= vahPrice and close > vahPrice
brokeBelowVal = profileReady and not na(valPrice) and prevClose >= valPrice and close < valPrice
retestVah = profileReady and not na(vahPrice) and close > open and low <= vahPrice and close >= vahPrice and prevClose > vahPrice
retestVal = profileReady and not na(valPrice) and close < open and high >= valPrice and close <= valPrice and prevClose < valPrice
rejectLong = profileReady and candleDirection == "BULLISH" and nz(lowerWickPercent) >= 55.0 and nz(bodyPercent) <= 35.0 and not na(valPrice) and low <= valPrice + nz(atrValue) * 0.25
rejectShort = profileReady and candleDirection == "BEARISH" and nz(upperWickPercent) >= 55.0 and nz(bodyPercent) <= 35.0 and not na(vahPrice) and high >= vahPrice - nz(atrValue) * 0.25
continuation = nz(bodyPercent) >= 60.0 and candleDirection != "NEUTRAL" and candleDirection == trendDirection

classification = rejectLong or rejectShort ? "REJECTION" : brokeAboveVah or brokeBelowVal ? "BREAKOUT" : retestVah or retestVal ? "RETEST" : continuation or bullEngulf or bearEngulf ? "CONTINUATION" : "NONE"

relatedLevel = brokeAboveVah or retestVah or rejectShort ? "VAH" : brokeBelowVal or retestVal or rejectLong ? "VAL" : profileReady and not na(pocPrice) and math.abs(close - pocPrice) <= nz(atrValue) * 0.25 ? "POC" : ""

pivotHigh = ta.pivothigh(high, swingLength, swingLength)
pivotLow = ta.pivotlow(low, swingLength, swingLength)
lastSwingHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
lastSwingLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)

payloadPartial = not profileReady or profileOverflow or sessionName == "UNKNOWN"
dataQualityHint = payloadPartial ? "PARTIAL" : "GOOD"

eventId = syminfo.tickerid + "-" + timeframe.period + "-" + str.tostring(time_close)

ohlcvJson = "\"ohlcv\":{\"open\":" + f_json_number(open) +
  ",\"high\":" + f_json_number(high) +
  ",\"low\":" + f_json_number(low) +
  ",\"close\":" + f_json_number(close) +
  ",\"volume\":" + f_json_number(volume) + "}"

levelsJson = "\"levels\":{\"pocAll\":" + f_json_number(profileReady ? pocPrice : na) +
  ",\"vahAll\":" + f_json_number(profileReady ? vahPrice : na) +
  ",\"valAll\":" + f_json_number(profileReady ? valPrice : na) +
  ",\"pocNonBroken\":[],\"vahNonBroken\":[],\"valNonBroken\":[]}"

sessionStartJson = na(sessionStartTs) ? "null" : f_json_time(sessionStartTs)
sessionEndJson = f_json_time(time_close)

sessionVolumeProfileJson = "\"sessionVolumeProfile\":{\"session\":" + f_json_string(sessionName) +
  ",\"sessionStart\":" + sessionStartJson +
  ",\"sessionEnd\":" + sessionEndJson +
  ",\"poc\":" + f_json_number(profileReady ? pocPrice : na) +
  ",\"vah\":" + f_json_number(profileReady ? vahPrice : na) +
  ",\"val\":" + f_json_number(profileReady ? valPrice : na) +
  ",\"hvn\":[],\"lvn\":[],\"acceptanceState\":" + f_json_string(acceptanceState) + "}"

// TPO / market profile remains unavailable in this bridge (proprietary / not implemented).
marketProfileJson = "\"marketProfile\":{\"tpoPoc\":null,\"initialBalanceHigh\":null,\"initialBalanceLow\":null,\"poorHigh\":null,\"poorLow\":null,\"singlePrints\":[],\"valueMigration\":\"UNKNOWN\",\"profileState\":\"UNKNOWN\",\"acceptanceState\":\"UNKNOWN\"}"

trendJson = "\"trend\":{\"direction\":" + f_json_string(trendDirection) +
  ",\"strength\":" + f_json_number_raw(trendStrength) +
  ",\"components\":[" +
  "{\"name\":\"gm_chart_ema_stack\",\"direction\":" + f_json_string(chartDir) + ",\"strength\":" + f_json_number_raw(chartStrength) + ",\"sourceTimeframe\":" + f_json_string(timeframe.period) + "}," +
  "{\"name\":\"gm_htf1_ema_stack\",\"direction\":" + f_json_string(htf1Dir) + ",\"strength\":" + f_json_number_raw(htf1Strength) + ",\"sourceTimeframe\":" + f_json_string(htf1Input) + "}," +
  "{\"name\":\"gm_htf2_ema_stack\",\"direction\":" + f_json_string(htf2Dir) + ",\"strength\":" + f_json_number_raw(htf2Strength) + ",\"sourceTimeframe\":" + f_json_string(htf2Input) + "}" +
  "]}"

confirmationCandleJson = "\"confirmationCandle\":{\"confirmed\":" + f_json_bool(confirmedNow) +
  ",\"direction\":" + f_json_string(candleDirection) +
  ",\"candleType\":" + f_json_string_or_null(candleType) +
  ",\"classification\":" + f_json_string(classification) +
  ",\"open\":" + f_json_number(open) +
  ",\"high\":" + f_json_number(high) +
  ",\"low\":" + f_json_number(low) +
  ",\"close\":" + f_json_number(close) +
  ",\"bodyPercent\":" + f_json_number(bodyPercent) +
  ",\"upperWickPercent\":" + f_json_number(upperWickPercent) +
  ",\"lowerWickPercent\":" + f_json_number(lowerWickPercent) +
  ",\"volume\":" + f_json_number(volume) +
  ",\"isClosed\":" + f_json_bool(confirmedNow) +
  ",\"relatedLevel\":" + f_json_string_or_null(relatedLevel) + "}"

optionalIndicatorsJson = "\"optionalIndicators\":{\"atr\":{\"length\":" + str.tostring(atrLength) +
  ",\"value\":" + f_json_number(atrValue) + "}" +
  ",\"session\":{\"heuristic\":\"UTC_HOUR\",\"name\":" + f_json_string(sessionName) +
  ",\"high\":" + f_json_number(sessionHigh) +
  ",\"low\":" + f_json_number(sessionLow) + "}" +
  ",\"structure\":{\"placeholder\":true,\"swingLength\":" + str.tostring(swingLength) +
  ",\"lastSwingHigh\":" + f_json_number(lastSwingHigh) +
  ",\"lastSwingLow\":" + f_json_number(lastSwingLow) + "}" +
  ",\"methodology\":{\"volumeProfile\":" + f_json_string(METHOD_VP) +
  ",\"trend\":" + f_json_string(METHOD_TREND) +
  ",\"candle\":" + f_json_string(METHOD_CANDLE) +
  ",\"volumeProfileKind\":\"equivalent_internal\"" +
  ",\"proprietaryTrendMeter\":\"unavailable\"" +
  ",\"proprietaryVolumeProfile\":\"unavailable\"" +
  ",\"proprietaryTpo\":\"unavailable\"}" +
  ",\"profileDiagnostics\":{\"binSize\":" + f_json_number(binSizeUsed) +
  ",\"valueAreaPct\":" + str.tostring(VA_PCT) +
  ",\"overflow\":" + f_json_bool(profileOverflow) +
  ",\"ready\":" + f_json_bool(profileReady) + "}}"

metadataJson = "\"metadata\":{\"scriptVersion\":" + f_json_string(SCRIPT_VERSION) +
  ",\"confirmedBarMode\":" + f_json_bool(confirmedBarMode) +
  ",\"diagnosticMode\":" + f_json_bool(diagnosticMode) +
  ",\"symbolOk\":" + f_json_bool(symbolOk) +
  ",\"partial\":" + f_json_bool(payloadPartial) +
  ",\"dataQualityHint\":" + f_json_string(dataQualityHint) +
  ",\"volumeProfileMethod\":" + f_json_string(METHOD_VP) +
  ",\"trendMethod\":" + f_json_string(METHOD_TREND) +
  ",\"candleMethod\":" + f_json_string(METHOD_CANDLE) + "}"

alertMessage = "{" +
  "\"schemaVersion\":\"1.0\"," +
  "\"source\":\"tradingview\"," +
  "\"eventId\":" + f_json_string(eventId) + "," +
  "\"webhookSecret\":" + f_json_string_or_null(payloadSecret) + "," +
  "\"symbol\":" + f_json_string(payloadSymbol) + "," +
  "\"exchange\":" + f_json_string_or_null(syminfo.prefix) + "," +
  "\"timeframe\":" + f_json_string(timeframe.period) + "," +
  "\"eventType\":" + f_json_string(eventType) + "," +
  "\"barTime\":" + f_json_time(time_close) + "," +
  "\"sentAt\":" + f_json_time(timenow) + "," +
  "\"isConfirmedBar\":" + f_json_bool(confirmedNow) + "," +
  "\"indicatorName\":\"GoldMetaBridge\"," +
  ohlcvJson + "," +
  levelsJson + "," +
  sessionVolumeProfileJson + "," +
  marketProfileJson + "," +
  trendJson + "," +
  confirmationCandleJson + "," +
  optionalIndicatorsJson + "," +
  metadataJson +
  "}"

// ---------------------------------------------------------------------------
// Script alerts (webhook JSON).
// TradingView Create Alert → Condition: "GoldMeta Bridge" → "Any alert() function call".
// Do NOT gate on barstate.isrealtime: alert() already only fires in realtime, and
 // realtime-only gating has caused some clients to hide "Any alert() function call"
 // and list only plot series instead. alert() is a no-op on historical bars.
// Frequency for production: alert.freq_once_per_bar_close (confirmed-bar mode).
// ---------------------------------------------------------------------------
var bool testAlertSent = false
bool emitAlert = enableAlertCalls and canEmitBar
if emitAlert and testAlertMode and not testAlertSent
    alert(alertMessage, alert.freq_once_per_bar)
    testAlertSent := true
else if emitAlert and not testAlertMode
    alert(alertMessage, confirmedBarMode ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
    testAlertSent := false
else if not testAlertMode
    testAlertSent := false

plot(showDiagnosticLevels ? sessionHigh : na, title="GoldMeta Session High", color=color.new(color.yellow, 0), linewidth=1, style=plot.style_linebr)
plot(showDiagnosticLevels ? sessionLow : na, title="GoldMeta Session Low", color=color.new(color.yellow, 0), linewidth=1, style=plot.style_linebr)
plot(showDiagnosticLevels and profileReady ? pocPrice : na, title="GoldMeta POC", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
plot(showDiagnosticLevels and profileReady ? vahPrice : na, title="GoldMeta VAH", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)
plot(showDiagnosticLevels and profileReady ? valPrice : na, title="GoldMeta VAL", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)

plotshape(diagnosticMode and not na(pivotHigh), title="GoldMeta Pivot High", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, offset=-swingLength)
plotshape(diagnosticMode and not na(pivotLow), title="GoldMeta Pivot Low", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, offset=-swingLength)

var label warningLabel = na
if showWarnings and barstate.islast
    if not symbolOk
        warningText = "GoldMeta expects XAUUSD. Current chart: " + syminfo.ticker
        if na(warningLabel)
            warningLabel := label.new(bar_index, high, warningText, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)
        else
            label.set_xy(warningLabel, bar_index, high)
            label.set_text(warningLabel, warningText)
    else if not na(warningLabel)
        label.delete(warningLabel)
        warningLabel := na

var table statusTable = table.new(position.top_right, 2, 7, border_width=1)
if showStatusTable and barstate.islast
    table.cell(statusTable, 0, 0, "GoldMeta", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statusTable, 1, 0, SCRIPT_VERSION, text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statusTable, 0, 1, "Symbol OK", text_color=color.white)
    table.cell(statusTable, 1, 1, symbolOk ? "YES" : "NO", text_color=color.white, bgcolor=symbolOk ? color.new(color.green, 35) : color.new(color.red, 20))
    table.cell(statusTable, 0, 2, "Confirmed", text_color=color.white)
    table.cell(statusTable, 1, 2, confirmedBarMode ? "ON" : "OFF", text_color=color.white)
    table.cell(statusTable, 0, 3, "Session", text_color=color.white)
    table.cell(statusTable, 1, 3, sessionName, text_color=color.white)
    table.cell(statusTable, 0, 4, "Trend", text_color=color.white)
    table.cell(statusTable, 1, 4, trendDirection + " " + str.tostring(trendStrength, "#"), text_color=color.white)
    table.cell(statusTable, 0, 5, "VP ready", text_color=color.white)
    table.cell(statusTable, 1, 5, profileReady ? "YES" : "NO", text_color=color.white, bgcolor=profileReady ? color.new(color.green, 35) : color.new(color.orange, 35))
    table.cell(statusTable, 0, 6, "Candle", text_color=color.white)
    table.cell(statusTable, 1, 6, classification, text_color=color.white)
