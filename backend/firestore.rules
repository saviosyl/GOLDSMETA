rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;

      match /settings/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /devices/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /journalEntries/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /decisions/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /setups/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /rawEvents/{document=**} {
        allow read: if false;
        allow write: if false;
      }

      match /eventDedupes/{document=**} {
        allow read: if false;
        allow write: if false;
      }

      match /notificationEvents/{document=**} {
        allow read: if false;
        allow write: if false;
      }

      match /marketSnapshots/{document=**} {
        allow read: if false;
        allow write: if false;
      }

      // V6 AutoTrade — owner read; client write forbidden (Admin SDK only).
      // Clients must never mark trade intents APPROVED/ACCEPTED/OPEN/CLOSED.
      match /brokerSettings/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /autoTradeRiskState/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /tradeIntents/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /brokerExecutions/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /brokerPositions/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /brokerEvents/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /autoTradeAudit/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /autoTradeLocks/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /brokerConnections/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /brokerSelection/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /t212SelectedInstrument/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /t212Proposals/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /t212ProposalIdempotency/{document=**} {
        allow read: if false;
        allow write: if false;
      }
      match /autoTradeActivity/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Isolated V6 preview AutoTrade namespace (server Admin SDK only).
      match /autoTradePreview/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Isolated Trading 212 Practice preview namespace (server Admin SDK only).
      match /autoTradeT212Preview/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Isolated Pepperstone cTrader Demo preview namespace (server Admin SDK only).
      match /autoTradeCTraderPreview/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /tradeIntentDealRefs/{document=**} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /webhookConnections/{webhookId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /processingJobs/{jobId} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
