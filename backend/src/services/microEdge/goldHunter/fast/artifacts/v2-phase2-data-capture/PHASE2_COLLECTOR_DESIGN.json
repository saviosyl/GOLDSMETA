    "forbidden": [
      "openShadowTrade",
      "ENTER",
      "EXIT",
      "tradeExit",
      "brokerRequestId",
      "brokerOrderId",
      "pnl"
    ]
  },
  "healthFields": [
    "serviceHealthy",
    "spotSubscribed",
    "depthSubscribed",
    "spotAgeMs",
    "depthAgeMs",
    "eventsReceived",
    "eventsDropped",
    "queueDepth",
    "queueLatencyP95",
    "eventLoopLagP95",
    "feedGapCount",
    "reconnectCount",
    "resyncCount",
    "bookCrossedCount",
    "candidateA",
    "candidateB",
    "candidateC",
    "brokerRequests",
    "brokerOrders",
    "shadowOrders",
    "captureStart",
    "captureDuration",
    "runId",
    "configSha256",
    "runtimeSha",
    "schemaVersion"
