{
  "title": "GOLD_HUNTER FAST — Phase 2 Data-Capture-Only Collector Design",
  "status": "DESIGN_ONLY_NOT_DEPLOYED",
  "deployed": false,
  "tradingLogicCreated": false,
  "identity": {
    "permissionScope": "SCOPE_VIEW",
    "brokerOrders": 0,
    "brokerRequests": 0,
    "shadowOrders": 0,
    "mutationSurface": "NONE",
    "executionAdapter": null,
    "openShadowTrade": false,
    "forbidEnterExitPnl": true
  },
  "purpose": "Collect independent clean Spot+Depth+candidate telemetry periods for genuine OOS entry-edge research",
  "architecture": {
    "serviceNameProposed": "gold-hunter-fast-research-collector",
    "separateFrom": [
      "gold-hunter-fast-shadow",
      "Core AutoTrade",
      "quote-worker"
    ],
    "mustNotReuseAsIs": [
      "GoldHunterFastLiveBridge (constructs ShadowExecutionAdapter / shadow trades)",
      "GhFastEngine trading state machine that opens positions",
      "ShadowExecutionAdapter"
    ],
    "reuseReadOnly": [
      "InMemoryDepthBook",
      "FastFeatureEngine",
      "evaluateSetupsDetailed",
      "frozenGhFastSoakConfig",
      "eventQueue patterns",
      "durableSink patterns (new GCS prefix)",
      "SCOPE_VIEW token/account helpers"
    ],
    "proposedFiles": [
      "backend/src/services/microEdge/goldHunter/fast/research/researchTypes.ts",
      "backend/src/services/microEdge/goldHunter/fast/research/nullExecutionGuard.ts",
      "backend/src/services/microEdge/goldHunter/fast/research/researchFeaturePipeline.ts",
      "backend/src/services/microEdge/goldHunter/fast/research/researchIngestBridge.ts",
      "backend/src/services/microEdge/goldHunter/fast/research/researchCollector.ts",
      "backend/src/services/microEdge/goldHunter/fast/research/researchDurableSink.ts",
      "backend/src/services/microEdge/runtime/fastResearchCaptureRuntime.ts",
      "backend/Dockerfile.gold-hunter-fast-research",
      "backend/tests/unit/microEdge/goldHunter/goldHunterFastResearchCaptureSafety.test.ts"
    ]
  },
  "captureFields": {
    "transport": [
      "receiveSeq",
      "brokerTimestampMs",
      "rawCallbackArrivalMs",
      "bridgeEnqueueMs",
      "engineProcessMs"
    ],
    "subscriptionSession": [
      "spotSubscribed",
      "depthSubscribed",
      "wsConnectionState",
      "disconnectTs",
      "reconnectStartTs",
      "reconnectEndTs",
      "resubscribeState"
    ],
    "queueLag": ["queueDepth", "enqueueToProcessLatencyMs", "eventLoopLagMs"],
    "market": [
      "SPOT",
      "DEPTH",
      "bid",
      "ask",
      "spread",
      "depthAvailability",
      "crossed",
      "bookGeneration"
    ],
    "specialists": [
      "eligible",
      "candidateSide",
      "rawQuality",
      "failedConditions",
      "selected"
    ],
    "features": [
      "midVel250",
      "midVel500",
      "midVel1s",
      "midVel2s",
      "midVel3s",
      "acceleration",
      "efficiency1s",
      "efficiency3s",
      "signedImbalance1s",
      "depthImbalance",
      "weightedImbalance",
      "addRemoveRates",
      "updateRate1s",
      "touches",
      "distHighLow"
