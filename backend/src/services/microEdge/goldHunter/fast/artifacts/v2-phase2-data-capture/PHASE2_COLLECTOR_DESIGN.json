    "gcsPrefix": "gold-hunter-fast/research-capture/<runId>/<YYYY-MM-DD>/",
    "doNotWriteTo": "gold-hunter-fast/live-shadow/",
    "estimatedCompressedPerDayMiB": [40, 80],
    "estimatedTenDayGiB": [0.4, 2.0],
    "retentionDaysHot": 90
