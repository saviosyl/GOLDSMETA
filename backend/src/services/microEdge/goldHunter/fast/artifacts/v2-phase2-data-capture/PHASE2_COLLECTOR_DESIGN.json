  "safetyProofPlan": [
    "no import/construction of ShadowExecutionAdapter",
    "boot asserts SCOPE_VIEW + mutationSurface NONE + brokerExecutionEnabled false",
    "health always brokerRequests/Orders/shadowOrders = 0",
    "chunks contain zero ENTER/EXIT/tradeExit",
    "unit tests refuse trading adapter injection"
  ],
  "testsRequired": [
    "researchCaptureSafety.test.ts",
    "health zeros",
    "SCOPE_VIEW fail-closed",
    "chunk schema round-trip",
    "resync/gap without trades",
    "A/B/C raw telemetry always",
