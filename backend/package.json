{
  "name": "goldmeta-backend",
  "version": "1.0.0-mvp",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/applyCTraderLayerProtoExtensions.mjs",
    "build": "rm -rf dist && tsc",
    "test": "vitest run --exclude tests/integration/signalOutcome.firestore.emulator.test.ts --exclude tests/integration/qualificationOwnership.firestore.emulator.test.ts",
    "test:firestore-emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 GCLOUD_PROJECT=goldmeta-signal-outcome-test GOOGLE_CLOUD_PROJECT=goldmeta-signal-outcome-test firebase emulators:exec --only firestore --project goldmeta-signal-outcome-test \"npx vitest run tests/integration/signalOutcome.firestore.emulator.test.ts tests/integration/qualificationOwnership.firestore.emulator.test.ts\"",
    "lint": "eslint src --ext .ts",
    "gate:micro-edge-core": "node scripts/microEdge/assertProtectedCoreUnchanged.mjs",
    "gate:micro-edge-imports": "node scripts/microEdge/assertMicroImportBoundary.mjs",
    "gate:micro-edge-mutations": "node scripts/microEdge/assertMicroBrokerMutationBan.mjs",
    "gate:gold-hunter-research-capture": "node scripts/microEdge/assertGoldHunterResearchCaptureSafety.mjs",
    "gate:micro-edge": "npm run gate:micro-edge-imports && npm run gate:micro-edge-mutations && npm run gate:micro-edge-core && npm run gate:gold-hunter-research-capture",
    "test:micro-edge": "MICRO_DEPLOYED_RUNTIME=false MICRO_STORAGE_MODE=memory APP_ENV=test vitest run tests/unit/microEdge",
    "micro-edge:backfill": "tsx scripts/microEdge/backfillCli.ts",
    "micro-edge:backfill-bars": "tsx scripts/microEdge/backfillCli.ts",
    "micro-edge:backfill-boundary-quotes": "tsx scripts/microEdge/backfillBoundaryQuotesCli.ts",
    "micro-edge:diagnostics": "tsx scripts/microEdge/diagnosticsCli.ts",
    "micro-edge:collector": "tsx scripts/microEdge/runLiveCollectorWorker.ts",
    "micro-edge:phase2a-smoke": "tsx scripts/microEdge/phase2aHistoricalSmokeCli.ts",
    "gold-hunter:research": "tsx scripts/microEdge/goldHunterResearchCli.ts",
    "gold-hunter:real7d": "tsx scripts/microEdge/goldHunterReal7dCli.ts",
    "gold-hunter:v11-fetch": "tsx scripts/microEdge/goldHunterV11FetchCli.ts",
    "gold-hunter:v11-research": "tsx scripts/microEdge/goldHunterV11ResearchCli.ts",
    "gold-hunter:v12-fetch": "tsx scripts/microEdge/goldHunterV12FetchCli.ts",
    "gold-hunter:v12-research": "tsx scripts/microEdge/goldHunterV12ResearchCli.ts",
    "gold-hunter:fast-real-probe": "tsx scripts/microEdge/goldHunterFastRealProbeCli.ts",
    "gold-hunter:fast-shadow": "tsx scripts/microEdge/runFastShadowRuntime.ts",
    "dev": "tsx watch src/index.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "verify:owner-auth": "tsx scripts/verifyOwnerAuthIntegrity.ts",
    "precheck:owner-auth-restore": "tsx scripts/preRestoreOwnerAuthCheck.ts",
    "gate:owner-auth-deploy": "tsx scripts/preDeployOwnerAuthHealthGate.ts",
    "proto:ctrader-extend": "node scripts/applyCTraderLayerProtoExtensions.mjs",
    "verify:ctrader-demo-margin-readonly": "tsx scripts/verifyCTraderDemoMarginReadOnly.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@reiryoku/ctrader-layer": "^2.2.0",
    "cors": "^2.8.6",
    "dotenv": "latest",
    "express": "latest",
    "firebase-admin": "latest",
    "firebase-functions": "latest",
    "openai": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
