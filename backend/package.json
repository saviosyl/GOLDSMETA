{
  "name": "goldmeta-backend",
  "version": "1.0.0-mvp",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:emulator": "npx firebase emulators:exec --only firestore \"FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 vitest run tests/integration/stockIntradayFirestore.emulator.test.ts\"",
    "lint": "eslint src --ext .ts",
    "dev": "tsx watch src/index.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "latest",
    "express": "latest",
    "firebase-admin": "latest",
    "firebase-functions": "latest",
    "openai": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "firebase-tools": "^13.35.1",
    "prettier": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
