NODE_ENV=development
APP_ENV=development
PORT=8080
STORAGE_BACKEND=firestore
ALLOW_TEST_AUTH_HEADER=false
# Do not put FIREBASE_* keys in backend/.env for Cloud Functions deploy — those prefixes are reserved.
# Production Functions resolve project id from GCLOUD_PROJECT / FIREBASE_CONFIG automatically.
# For local runs you may export FIREBASE_PROJECT_ID / FIREBASE_REGION in the shell instead.
# FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# FIREBASE_REGION=us-central1
WEBHOOK_PUBLIC_BASE_URL=https://replace-with-functions-url
WEBHOOK_MAX_SKEW_MS=300000
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=60
PAYLOAD_SIZE_LIMIT=128kb
AI_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CALLS_PER_HOUR=20
# Backend-only encryption key for broker API credentials (never commit real values).
# Required in production when storing broker secrets. Dev/test fall back to a local key.
BROKER_SECRETS_ENCRYPTION_KEY=replace-with-32plus-char-secret-from-secret-manager


# Web Push (PWA) — optional phase. Leave empty until you enable notifications.
# Never put VAPID_PRIVATE_KEY in the web client or GitHub unless a dedicated secret store is used.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@goldmeta.app
