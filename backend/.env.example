NODE_ENV=development
APP_ENV=development
PORT=8080
STORAGE_BACKEND=firestore
ALLOW_TEST_AUTH_HEADER=false
# Cloud Functions .env reserves FIREBASE_* and GCLOUD_PROJECT. Use GOLDMETA_PROJECT_ID instead.
GOLDMETA_PROJECT_ID=replace-with-firebase-project-id
# Region defaults to us-central1 in code (do not set FIREBASE_REGION in Functions .env).
WEBHOOK_PUBLIC_BASE_URL=https://us-central1-goldmeta-web.cloudfunctions.net/api
WEBHOOK_MAX_SKEW_MS=300000
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=60
PAYLOAD_SIZE_LIMIT=128kb
AI_ENABLED=false
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CALLS_PER_HOUR=20
# Backend-only encryption key for broker API credentials (never commit real values).
# Required in production when storing broker secrets. Dev/test fall back to a local key.
BROKER_SECRETS_ENCRYPTION_KEY=replace-with-32plus-char-secret-from-secret-manager


# Web Push (PWA) — optional phase. Leave empty until you enable notifications.
# Never put VAPID_PRIVATE_KEY in the web client or GitHub unless a dedicated secret store is used.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@goldmeta.app

# Phase 3 Stage 3 — LIVE + TEST setup lifecycle tracking (broker still hard-disabled)
SETUP_TRACKING_ENABLED=true
SETUP_TRACKING_ENVIRONMENTS=TEST,LIVE
NEW_SETUP_CREATION_ENABLED=true
ANALYSIS_GENERATION_ENABLED=true
# GoldMeta V4 Stage B — LIVE shadow only (does not replace V3 production signals)
# Fail-closed: actionable / notifications / LIVE setup creation are hard-off in code.
V4_DEPLOYMENT_STAGE=LIVE_SHADOW
V4_SHADOW_COMPUTE_ENABLED=true
V4_SHADOW_LIFECYCLE_ENABLED=true
V4_SHADOW_PERSIST_ENABLED=true
V4_ACTIONABLE_SETUP_ENABLED=false
V4_LIVE_SETUP_CREATION=false
V4_NOTIFICATIONS_ENABLED=false
V4_ML_META_FILTER_ENABLED=false
# Broker remains disabled for all environments
BROKER_MODE=DISABLED

# GoldMeta V5 — trading intelligence (never overrides V4; never brokers)
V5_INTELLIGENCE_ENABLED=true
V5_LEARNING_ENABLED=true
V5_BRIEFING_ENABLED=true
V5_REPLAY_ENABLED=true
V5_SCREENSHOT_COMPARE_ENABLED=true
V5_WEEKLY_COACH_ENABLED=true

