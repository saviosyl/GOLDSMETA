{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldmeta.app/schemas/decision.schema.json",
  "title": "GoldMetaDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "symbol",
    "generatedAt",
    "marketDataTime",
    "validUntil",
    "decision",
    "confidence",
    "confidenceLabel",
    "marketRegime",
    "dataQuality",
    "isProvisional",
    "setupScore",
    "entry",
    "stopLoss",
    "takeProfits",
    "riskReward",
    "breakeven",
    "earlyExit",
    "bullishEvidence",
    "bearishEvidence",
    "reasonCodes",
    "reasonSummary",
    "warnings",
    "missingInputs",
    "invalidation",
    "disclaimer",
    "lifecycleState",
    "ruleConfigVersion",
    "backendVersion"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "decisionId": { "type": "string" },
    "symbol": { "type": "string", "const": "XAUUSD" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "marketDataTime": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "decision": { "type": "string", "enum": ["BUY", "SELL", "WAIT"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidenceLabel": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH", "VERY_HIGH"]
    },
    "marketRegime": {
      "type": "string",
      "enum": [
        "TRENDING_UP",
        "TRENDING_DOWN",
        "RANGING",
        "TRANSITION",
        "UNKNOWN"
      ]
    },
    "dataQuality": {
      "type": "string",
      "enum": ["GOOD", "PARTIAL", "STALE", "CONFLICTED", "INVALID"]
    },
    "isProvisional": { "type": "boolean" },
    "setupScore": { "type": "number", "minimum": -100, "maximum": 100 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MARKET",
            "LIMIT",
            "ENTRY_ZONE",
            "WAIT_FOR_CONFIRMATION",
            "NONE"
          ]
        },
        "price": { "type": ["number", "null"] },
        "zoneLow": { "type": ["number", "null"] },
        "zoneHigh": { "type": ["number", "null"] },
        "condition": { "type": ["string", "null"] }
      }
    },
    "stopLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "reason"],
      "properties": {
        "price": { "type": ["number", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "takeProfits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "price", "reason"],
        "properties": {
          "label": { "type": "string" },
          "price": { "type": "number" },
          "reason": { "type": "string" }
        }
      }
    },
    "riskReward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tp1": { "type": ["number", "null"] },
        "tp2": { "type": ["number", "null"] },
        "tp3": { "type": ["number", "null"] }
      }
    },
    "breakeven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "HOLD_ORIGINAL_STOP",
            "MOVE_TO_BREAKEVEN",
            "LOCK_PARTIAL_PROFIT"
          ]
        },
        "trigger": { "type": ["string", "null"] },
        "newStop": { "type": ["number", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "earlyExit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitNow", "conditions"],
      "properties": {
        "exitNow": { "type": "boolean" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bullishEvidence": { "type": "array", "items": { "type": "string" } },
    "bearishEvidence": { "type": "array", "items": { "type": "string" } },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "reasonSummary": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missingInputs": { "type": "array", "items": { "type": "string" } },
    "invalidation": { "type": "string" },
    "disclaimer": { "type": "string" },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "NORMALISING",
        "INCOMPLETE",
        "ANALYSING",
        "ACTIVE",
        "SUPERSEDED",
        "INVALIDATED",
        "EXPIRED",
        "CLOSED"
      ]
    },
    "snapshotId": { "type": ["string", "null"] },
    "ruleConfigVersion": { "type": "string" },
    "pineScriptVersion": { "type": ["string", "null"] },
    "backendVersion": { "type": "string" },
    "aiModelId": { "type": ["string", "null"] },
    "aiPromptVersion": { "type": ["string", "null"] },
    "aiSafetyDowngraded": { "type": "boolean", "default": false },
    "notificationSent": { "type": "boolean", "default": false },
    "currentSession": { "type": ["string", "null"] },
    "higherTimeframeBias": {
      "type": ["string", "null"],
      "enum": ["BULLISH", "BEARISH", "NEUTRAL", null]
    },
    "lastKnownPrice": { "type": ["number", "null"] },
    "dataSourceLabel": {
      "type": "string",
      "enum": ["LIVE", "DELAYED", "STALE", "MOCK", "OFFLINE"]
    }
  }
}
