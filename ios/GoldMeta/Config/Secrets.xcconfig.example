// Copy to ios/GoldMeta/Config/Secrets.xcconfig on your Mac.
// Never commit Secrets.xcconfig.

// Local emulator/default development API:
// GOLDMETA_API_BASE_URL = http:/$()/127.0.0.1:8080

// Firebase Functions HTTPS endpoint for a deployed backend:
// GOLDMETA_API_BASE_URL = https:/$()/us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api

// DEBUG can use mock auth for local UI when Firebase is not configured.
// Set to NO when testing real Firebase email/password auth on a simulator/device.
GOLDMETA_USE_MOCK_AUTH = YES
